{
  "manifest_version": 3,
  "name": "SamuBookMarker",
  "version": "2.0.0",
  "description": "通过私有 Gist 手动同步书签，口令加密，跨浏览器可用。",
  "permissions": ["bookmarks", "storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SamuBookMarker 书签同步",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "samubookmarker@samudev.local",
      "strict_min_version": "115.0"
    }
  }
}
